# 环境 profile：local(本机,需 application-local.yml) / dev / test / ci / prod
# 生产环境必须使用 prod，并确保下列敏感变量齐全
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:mysql://localhost:3306/chip?characterEncoding=utf-8&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=
SERVER_PORT=8080

# RSA login encryption keys
RSA_PUBLIC_KEY=
RSA_PRIVATE_KEY=

# LLM providers
DEEPSEEK_API_KEY=
VOLC_API_KEY=
GPT_API_KEY=

# Alipay
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=
